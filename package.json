{
  "name": "campus-exchange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:component": "jest src/components/__tests__",
    "test:pages": "jest src/app/__tests__",
    "test:api": "jest src/lib/__tests__",
    "test:unit": "jest --testPathPattern='\\.(test|spec)\\.(js|jsx)$'",
    "test:frontend": "jest src/",
    "test:verbose": "jest --verbose",
    "test:silent": "jest --silent",
    "test:systems": "start-server-and-test dev:both http://localhost:3000 'playwright test'",
    "dev:both": "concurrently \"npm run dev\" \"cd backend && npm run dev\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:systems",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview"
  },
  "dependencies": {
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.57.0",
    "react-hot-toast": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.2",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "playwright": "^1.53.1",
    "postcss": "^8.5.4",
    "start-server-and-test": "^2.0.12",
    "tailwindcss": "^4.1.8"
  }
}
